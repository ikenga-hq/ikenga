[Unit]
Description=Ikenga Remote Server Daemon
After=network.target

[Service]
Type=simple
User=ikenga
Group=ikenga
WorkingDirectory=/opt/ikenga
# No --host here ON PURPOSE. clap's default is 127.0.0.1, so a unit that is
# missing or has a malformed EnvironmentFile binds loopback and is unreachable
# — the safe failure. The bind address comes from IKENGA_HOST in the env file
# below, which bootstrap-credentials.sh sets to this host's Tailscale address.
#
# The previous value was `--host 0.0.0.0`, which contradicted the perimeter
# note further down: on a box with a public IP that is a public listener, and
# every route here can run code or read the user's files.
ExecStart=/opt/ikenga/bin/ikenga-server --port 4000 --static-dir /opt/ikenga/dist --data-dir /opt/ikenga/data
Restart=always
RestartSec=5
LimitNOFILE=65536

# Carries IKENGA_AUTH_TOKEN and IKENGA_VAULT_KEY, written by
# shell/scripts/server/bootstrap-credentials.sh. Run that BEFORE first start.
#
# This binds 0.0.0.0. Every route the daemon serves can run code or read the
# user's files, so the bearer token is what stands between the process and the
# network. The daemon fails closed — with no token it mints one at startup and
# logs it — but a minted token rotates on every restart, so a managed deploy
# needs the pinned one from this file. Do not remove EnvironmentFile to "fix" a
# startup failure; fix the file.
EnvironmentFile=/opt/ikenga/.env

# Sits behind a Tailscale perimeter (ikenga#113 / WP-14b), enforced by binding
# IKENGA_HOST to the tailnet address rather than by the token alone. The token
# is defence in depth, not the whole perimeter.

# --- Sandboxing ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# The daemon writes SQLite + vault state here.
#
# ProtectSystem=strict makes the WHOLE hierarchy read-only apart from these
# paths — including the service user's home. A remote terminal that cannot
# write to its own home directory is not a usable dev shell, so the home of
# whatever user this runs as has to be listed too. Add it at deploy time to
# match the configured User=, e.g.:
#   ReadWritePaths=/opt/ikenga/data /home/<service-user>
ReadWritePaths=/opt/ikenga/data

[Install]
WantedBy=multi-user.target
