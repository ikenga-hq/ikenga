[Unit]
Description=Ikenga Remote Server Daemon
After=network.target

[Service]
Type=simple
User=ikenga
Group=ikenga
WorkingDirectory=/opt/ikenga
# No --host here ON PURPOSE. clap's default is 127.0.0.1, so a unit that is
# missing or has a malformed EnvironmentFile binds loopback and is unreachable
# — the safe failure. The bind address comes from IKENGA_HOST in the env file
# below. Set it to this host's Tailscale address, or leave it unset and put a
# reverse proxy on loopback in front. Never bind a public address directly:
# every route here can run code or read the user's files.
ExecStart=/opt/ikenga/bin/ikenga-server --port 4000 --static-dir /opt/ikenga/dist --data-dir /opt/ikenga/data
Restart=always
RestartSec=5
LimitNOFILE=65536

# Carries IKENGA_AUTH_TOKEN (and IKENGA_HOST, plus any agent API keys). Create
# it BEFORE first start — scripts/server/README.md, "Environment file".
#
# The bearer token is what stands between the process and the network. The
# daemon fails closed — with no token it mints one at startup and logs it —
# but a minted token rotates on every restart, so a managed deploy needs a
# pinned one from this file. Do not remove EnvironmentFile to "fix" a startup
# failure; fix the file.
EnvironmentFile=/opt/ikenga/.env

# The perimeter is the bind address (IKENGA_HOST on the tailnet, or loopback
# behind a proxy), not the token alone. The token is defence in depth.

# --- Sandboxing ---
#
# KillMode is deliberately left at the default `control-group` today: stopping
# or restarting the unit kills every process in its cgroup, which is right
# while the daemon does not serve Chi runs (terminals don't survive a daemon
# restart by design — ADR-023 D5).
#
# When Chi lands on the daemon this must change. A persistent Chi run is a
# `chi-runner` spawned DETACHED into its own process group (WP-18b) so it
# outlives a restart — but a process group does NOT escape a systemd cgroup,
# and `control-group` would kill every runner with the unit. Either launch
# each detached chi-runner in its own transient scope
#   systemd-run --scope --collect … chi-runner
# so it leaves this unit's cgroup, or switch this unit to `KillMode=process`
# — blunter: then EVERY orphan this unit spawns outlives it, not just runners.
# See ADR-023 D5 (docs/adr/023-remote-tier-execution-isolation.md in the
# workspace repo): Chi runs survive a daemon restart, terminals don't.
# The T1 unit, ikenga-server-t1.service, carries that fix (KillMode=process,
# G-PRINCIPAL §9.4); scripts/server/README.md explains the choice. Apply the
# same line here once this T0 daemon serves Chi runs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# The daemon writes SQLite + vault state here.
#
# ProtectSystem=strict makes the WHOLE hierarchy read-only apart from these
# paths — including the service user's home. A remote terminal that cannot
# write to its own home directory is not a usable dev shell, so the home of
# whatever user this runs as has to be listed too. Add it at deploy time to
# match the configured User=, e.g.:
#   ReadWritePaths=/opt/ikenga/data /home/<service-user>
ReadWritePaths=/opt/ikenga/data

[Install]
WantedBy=multi-user.target
