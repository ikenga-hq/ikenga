# Public HTTPS perimeter: Caddy + Let's Encrypt on 443, daemon on loopback.
# Requires TIER=t1 (the provisioner refuses t0 on a public host) and DNS for
# PUBLIC_HOST pointing at this box BEFORE the run.
HOSTNAME_WANT=ikenga-dixtrit
TIER=t1
PERIMETER=public-https
VERSION=0.19.4
ADMIN_USER=ops
ADMIN_SSH_KEYS_FILE=/root/provision/ops_authorized_keys
PUBLIC_HOST=ikenga.example.com
# SSH_ACCESS=tailnet   # keep SSH off the public interface (needs the host on a
#                      # tailnet: TS_AUTHKEY_FILE to join, or already joined)
ACME_EMAIL=ops@example.com
LIBS=(bun node22 ffmpeg git-lfs jq)
# Supported AGENT_CLIS: claude (Claude Code), codex (OpenAI Codex CLI),
# opencode (OpenCode), pi (Pi Coding Agent), agy (Antigravity CLI).
AGENT_CLIS=(claude)

# Secrets: do NOT put secrets in this profile or on argv.
# SECRETS_FROM points to a chmod 600 file of KEY=VALUE lines copied into .env.
# OpenRouter is a provider key, not a CLI: OPENROUTER_API_KEY goes in SECRETS_FROM.
# Among the installed CLIs, opencode and pi directly support OPENROUTER_API_KEY.
# SECRETS_FROM=/root/provision/secrets.env

# Accounts, shared project clones and scoped secrets (README "Shared projects
# and scoped secrets"). Accounts are created with `ikenga-server accounts
# create`; `sudo ikenga-provision sync-accounts` converges these after that.
# ACCOUNTS=(ada grace rex ruby)       # login names (unix user ik-<name>); empty = every ik-* user
# AGENT_ACCOUNTS=(rex ruby)           # who a secret scoped `agents` goes to
# PROJECTS=("app=https://github.com/example-org/app.git#main")   # name=git-url[#branch]
# PROJECTS_DIR=/srv/ikenga/projects   # root-owned read-only bare mirror per project
# PROJECTS_READ=members               # members = read-only ACLs for the managed accounts; world = anyone on the box
# PROJECTS_MEMBERS=()                 # default: every managed account; each gets its own clone ~/projects/<name> on <account>/main
# PROJECTS_BRANCH_PREFIX=""           # branch = <prefix><account>/main
# PROJECTS_TOKEN_SECRET=GIT_DEPLOY_TOKEN   # a `[root]` secret below: https token for private repos
# Scoped secrets: root-only (0600) file, one `[scope] NAME=value` per line,
# scope = everyone | agents | <account>[,<account>] | root. Never in this profile.
# SECRETS_FILE=/root/provision/secrets.scoped

# SSH tunnels: see example-tailnet.env and README "SSH tunnels".
# TUNNELS=( "devotee-db=pgtunnel@157.180.123.30 5544:127.0.0.1:55432" )
# TUNNEL_KNOWN_HOSTS=( "157.180.123.30 ssh-ed25519 AAAA..." )
# TUNNEL_ALLOW_USERS=(ikenga-backup)   # who may connect to the tunnels' local ports besides root (default: the backup user when BACKUPS_ENABLED=1)

# Postgres backups to GCS: see example-tailnet.env and README "Database backups".
# BACKUPS_ENABLED=1
# BACKUP_CONFIG=/root/provision/backup-config.json
# BACKUP_GCS_KEY_SECRET=GCS_BACKUP_KEY_B64

# Swap: a file on the box so a few agent sessions cannot OOM it (README "Swap";
# `sudo ikenga-provision swap` converges just this). Other swap already active
# = left alone. SWAP_SIZE=off removes what a previous run made.
# SWAP_SIZE=auto        # auto (4G up to 8 GB RAM, else 2G) | 2G | 4096M | off
# SWAPPINESS=10
# SWAP_FILE=/swapfile
