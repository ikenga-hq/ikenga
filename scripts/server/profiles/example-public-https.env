# Public HTTPS perimeter: Caddy + Let's Encrypt on 443, daemon on loopback.
# Requires TIER=t1 (the provisioner refuses t0 on a public host) and DNS for
# PUBLIC_HOST pointing at this box BEFORE the run.
HOSTNAME_WANT=ikenga-dixtrit
TIER=t1
PERIMETER=public-https
VERSION=0.19.4
ADMIN_USER=ops
ADMIN_SSH_KEYS_FILE=/root/provision/ops_authorized_keys
PUBLIC_HOST=ikenga.example.com
# SSH_ACCESS=tailnet   # keep SSH off the public interface (needs the host on a
#                      # tailnet: TS_AUTHKEY_FILE to join, or already joined)
ACME_EMAIL=ops@example.com
LIBS=(bun node22 ffmpeg git-lfs jq)
# Supported AGENT_CLIS: claude (Claude Code), codex (OpenAI Codex CLI),
# opencode (OpenCode), pi (Pi Coding Agent), agy (Antigravity CLI).
AGENT_CLIS=(claude)

# Secrets: do NOT put secrets in this profile or on argv.
# SECRETS_FROM points to a chmod 600 file of KEY=VALUE lines copied into .env.
# OpenRouter is a provider key, not a CLI: OPENROUTER_API_KEY goes in SECRETS_FROM.
# Among the installed CLIs, opencode and pi directly support OPENROUTER_API_KEY.
# SECRETS_FROM=/root/provision/secrets.env
