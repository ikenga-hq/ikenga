# Tailnet perimeter: the daemon binds the tailnet address only; nothing is
# open on the public interface. Every user needs Tailscale + an ACL rule.
HOSTNAME_WANT=ikenga-royalti
TIER=t1
PERIMETER=tailnet
VERSION=0.19.4
ADMIN_USER=ops
ADMIN_SSH_KEYS_FILE=/root/provision/ops_authorized_keys   # public keys only
TS_AUTHKEY_FILE=/root/provision/ts_authkey                 # chmod 600; never argv
TS_HOSTNAME=ikenga-royalti
LIBS=(bun node22 git-lfs jq ripgrep sqlite3)
AGENT_CLIS=(claude)
# SECRETS_FROM=/root/provision/secrets.env                 # KEY=VALUE lines, copied by name
