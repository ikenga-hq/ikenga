{
  "id": "com.ikenga.engine-claude-code",
  "name": "Claude Code Engine",
  "version": "0.1.0",
  "ikenga_api": "1",
  "kind": "engine",

  "author": {
    "name": "Royalti",
    "key": "royalti"
  },

  "ui": {},

  "permissions": {
    "shell.execute": ["claude"],
    "fs.read": ["$pkg_data/sessions/**"],
    "fs.write": ["$pkg_data/sessions/**"]
  },

  "settings": {
    "schema": [
      {
        "key": "claude_binary",
        "type": "string",
        "label": "Path to `claude` CLI",
        "default": "claude",
        "description": "Resolved against $PATH if not absolute."
      },
      {
        "key": "model",
        "type": "string",
        "label": "Default model",
        "default": "claude-sonnet-5-5"
      }
    ]
  },

  "engine": {
    "agentId": "claude-code",
    "display": "Claude Code",
    "capabilities": {
      "streaming": true,
      "toolUse": true,
      "thinking": true,
      "artifacts": true,
      "fileAttachments": true,
      "imageInput": true,
      "slashCommands": true,
      "modelSwitching": true,
      "promptCaching": true,
      "agenticTools": true,
      "mcp": true,
      "sessionResume": true
    },
    "onboarding": {
      "requiredVaultKeys": ["ANTHROPIC_API_KEY"],
      "requiredEnvVars": [],
      "authCommand": "claude login",
      "docsUrl": "https://docs.anthropic.com/en/docs/claude-code"
    }
  }
}
