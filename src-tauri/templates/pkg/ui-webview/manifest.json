{
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "{{version}}",
  "ikenga_api": "4",
  "kind": "embedded",
  "author": { "name": "{{author_name}}", "key": "{{author_key}}" },

  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": ["default"],
      "allowed_origins": ["https://example.com", "https://*.example.com"]
    }
  },

  "ui": {
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://example.com",
        "partition": "default"
      }
    ]
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [],
    "supabase.tables": [],
    "vault.keys": []
  }
}
