{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": []
	},
	"include": ["sw.ts"]
}
